---
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'caseStudies'> }
const { entry } = Astro.props;
---
<a class="card panel" href={`/work/${entry.id}/`}>
  <div class="thumb" aria-hidden="true"></div>
  <h3>{entry.data.title}</h3>
  <p class="muted">{entry.data.summary}</p>
  {entry.data.tags.length > 0 && (
    <ul class="tags">{entry.data.tags.map((t) => <li>{t}</li>)}</ul>
  )}
</a>
<style>
  .card { display: block; padding: 24px; text-decoration: none; transition: border-color 0.15s; }
  .card:hover { border-color: #3a4549; }
  .thumb { height: 140px; border-radius: 5px; margin-bottom: 18px; border: 1px solid var(--line);
    background: repeating-linear-gradient(135deg, #1b2226 0 10px, #182024 10px 20px); }
  h3 { margin: 0 0 6px; font-size: 17px; }
  p { margin: 0; font-size: 13.5px; }
  .tags { list-style: none; padding: 0; margin: 14px 0 0; display: flex; gap: 8px; flex-wrap: wrap; }
  .tags li { font-size: 12px; color: var(--accent); border: 1px solid #2c4a38; background: #12201a; padding: 2px 8px; border-radius: 4px; }
</style>
