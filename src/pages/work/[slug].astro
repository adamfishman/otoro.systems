---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getCaseStudies, isoDate } from '../../lib';

export async function getStaticPaths() {
  return (await getCaseStudies()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.summary}>
  <article>
    <a class="back muted" href="/work/">← Work</a>
    <h1>{entry.data.title}</h1>
    <p class="meta muted"><time datetime={entry.data.date.toISOString()}>{isoDate(entry.data.date)}</time>{entry.data.tags.length > 0 && <> · {entry.data.tags.join(' · ')}</>}</p>
    <p class="summary">{entry.data.summary}</p>
    <div class="prose"><Content /></div>
  </article>
</Base>
<style>
  .back { display: inline-block; margin-top: 30px; font-size: 13px; text-decoration: none; }
  h1 { font-size: clamp(28px, 5vw, 42px); margin: 18px 0 10px; max-width: 24ch; }
  .meta { font-size: 13px; margin: 0 0 24px; }
  .summary { font-size: 17px; max-width: 60ch; margin: 0 0 40px; padding-bottom: 32px; border-bottom: 1px solid var(--line); }
</style>
