---
import Base from '../layouts/Base.astro';
const email = 'adam@otoro.systems';
---
<Base title="Contact" description="Get in touch with Otoro Systems about an embedded software project.">
  <h1 class="page-title">Contact</h1>
  <div class="prose">
    <p>Have a project in mind? Email is the best way to reach me.</p>
    <p class="muted">Placeholder: what to include in a first message (product, timeline, where you're stuck).</p>
  </div>
  <p class="email panel"><span class="accent">$</span> mail <a href={`mailto:${email}`}>{email}</a></p>
</Base>
<style>
  .page-title { font-size: 40px; margin: 40px 0 24px; }
  .email { display: inline-block; padding: 16px 22px; font-size: 16px; margin-top: 12px; }
  .email a { color: var(--ink); }
</style>
