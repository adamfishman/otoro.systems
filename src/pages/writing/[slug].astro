---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, isoDate } from '../../lib';

export async function getStaticPaths() {
  return (await getPosts()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description}>
  <article>
    <a class="back muted" href="/writing/">← Writing</a>
    <h1>{entry.data.title}</h1>
    <p class="meta muted"><time datetime={entry.data.date.toISOString()}>{isoDate(entry.data.date)}</time></p>
    <div class="prose"><Content /></div>
  </article>
</Base>
<style>
  .back { display: inline-block; margin-top: 30px; font-size: 13px; text-decoration: none; }
  h1 { font-size: clamp(28px, 5vw, 42px); margin: 18px 0 10px; max-width: 24ch; }
  .meta { font-size: 13px; margin: 0 0 40px; }
</style>
