{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static-assets-only Worker: Cloudflare serves the Astro build output directly.
  "name": "otoro-systems",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Branch builds on Cloudflare run `npx wrangler preview`, which needs this block.
  "previews": {}
}
